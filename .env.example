# =============================================================================
# Sistema de Videovigilancia - Variables de Entorno
# =============================================================================
# Copia este archivo como .env y configura los valores requeridos.
# cp .env.example .env

# -----------------------------------------------------------------------------
# REQUERIDAS (el sistema no arranca sin estas)
# -----------------------------------------------------------------------------

# URL del stream RTSP de la cámara
# Ejemplo: rtsp://usuario:password@192.168.1.100:554/stream1
RTSP_URL=

# Token del bot de Telegram (obtener desde @BotFather)
TELEGRAM_BOT_TOKEN=

# ID del chat de Telegram donde enviar alertas (obtener desde @userinfobot)
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# OPCIONALES (tienen valores por defecto)
# -----------------------------------------------------------------------------

# Umbral de detección de movimiento (0-255, mayor = menos sensible)
# Default: 25
MOTION_THRESHOLD=25

# Área mínima en píxeles para considerar movimiento válido
# Default: 500
MOTION_MIN_AREA=500

# Confianza mínima para detección YOLO (0.0-1.0)
# Default: 0.5
YOLO_CONFIDENCE=0.5

# Clases objetivo de YOLO separadas por coma
# 0=persona, 2=carro, 3=moto, 5=bus, 7=camión, 16=perro (ver clases COCO)
# Default: 0,2,3,5,7,16
YOLO_TARGET_CLASSES=0,2,3,5,7,16

# Intervalo entre capturas en segundos
# Default: 1.0
CAPTURE_INTERVAL=1.0

# Tiempo mínimo entre alertas consecutivas en segundos
# Default: 30
ALERT_COOLDOWN=30

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO
